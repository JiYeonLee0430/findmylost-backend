generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ORG_ADMIN
  SUPER_ADMIN // 서비스 운영자: 기관 인증 신청 승인용
}

enum ItemType {
  LOST  // 분실물
  FOUND // 습득물
}

enum ItemStatus {
  OPEN
  RETURNED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Institution {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  domain    String?  @unique
  createdAt DateTime @default(now())

  users                User[]
  items                Item[]
  verificationRequests OrgVerificationRequest[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  name      String
  role      Role     @default(USER)
  emailVerifiedAt DateTime?
  emailTokens     EmailVerificationToken[]
  createdAt DateTime @default(now())

  // MFA (TOTP)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String? // AES-256-GCM 암호화된 값 저장
  mfaEnabledAt DateTime?

  // 기관 승인 후에만 채워짐
  institutionId Int?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  items                Item[]
  verificationRequests OrgVerificationRequest[] @relation("RequestApplicant") // 내가 낸 신청
  reviewedRequests     OrgVerificationRequest[] @relation("AdminReviews")     // 내가 심사한 신청

  startedConversations Conversation[] @relation("ConversationStarter")
  ownedConversations   Conversation[] @relation("ConversationOwner")
  messages             Message[]
}

// 기관 인증 신청 (승인되면 User.role = ORG_ADMIN, institutionId 세팅)
model OrgVerificationRequest {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation("RequestApplicant", fields: [userId], references: [id])

  institutionId Int
  institution   Institution @relation(fields: [institutionId], references: [id])

  evidence String? // 재직 증빙 설명/파일 키 등
  status   VerificationStatus @default(PENDING)

  reviewedById Int?
  reviewedBy   User? @relation("AdminReviews", fields: [reviewedById], references: [id])

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status])
}

model Item {
  id       Int        @id @default(autoincrement())
  title    String
  type     ItemType
  category String
  status   ItemStatus @default(OPEN)

  locationLat     Float
  locationLng     Float
  storageLocation String? // 습득물: 보관 장소
  lostLocation    String? // 분실물: 분실 장소 (글로 적는 장소)
  content         String? @db.Text // 게시글 본문 설명
  
  // Lambda가 POST /internal/items/:id/embedding 으로 채움
  imageVector Unsupported("vector(1024)")?

  createdAt DateTime @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  institutionId Int?         @map("org_id")
  institution   Institution? @relation(fields: [institutionId], references: [id])

  images ItemImage[]
  embeddings      ImageEmbedding[]
  conversations   Conversation[] //이 글에 대한 대화방

  @@index([institutionId])
  @@index([type, status])
}

model ItemImage {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  s3Key     String // items/{itemId}/{파일명}  (전체 URL이 아니라 key만 저장)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([itemId])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // 원문 토큰은 저장하지 않고 sha256 해시만 저장
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// 공공 API(경찰청 습득물)에서 Lambda가 수집해 저장하는 습득물
model PublicItem {
  id              Int       @id @default(autoincrement())
  atcId           String
  fdSn            String
  name            String // 물품명
  category        String? // 물품 분류명
  foundDate       DateTime? @db.Date // 습득일자
  storagePlace    String? // 보관 장소 (기관 이름 원문)
  imageUrl        String?
  institutionName String?
  phone           String?
  content         String?   @db.Text // 특이사항
  region          String? // 지역명 (예: 서울)
  raw             Json // 원본 응답 전체. API 응답으로는 내려보내지 않음
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([atcId, fdSn])
  @@index([foundDate])
  @@index([category])
  @@index([region])
}

/// 사진(s3Key)마다 벡터 1개. Lambda가 사진 등록보다 먼저 보내도 저장되도록 ItemImage와 분리
model ImageEmbedding {
  id        Int                         @id @default(autoincrement())
  itemId    Int
  item      Item                        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  s3Key     String                      @unique
  vector    Unsupported("vector(1024)")
  model     String?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @default(now())

  @@index([itemId])
}

/// 대화방: 게시글 하나 + 문의한 사람 한 명당 1개
model Conversation {
  id                Int       @id @default(autoincrement())
  itemId            Int
  item              Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  starterId         Int // 문의한 사람
  starter           User      @relation("ConversationStarter", fields: [starterId], references: [id], onDelete: Cascade)
  ownerId           Int // 글쓴이
  owner             User      @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  starterLastReadAt DateTime  @default(now()) // 문의자가 마지막으로 읽은 시각
  ownerLastReadAt   DateTime  @default(now()) // 글쓴이가 마지막으로 읽은 시각
  lastMessageAt     DateTime  @default(now()) // 대화 목록 정렬용
  createdAt         DateTime  @default(now())
  messages          Message[]

  @@unique([itemId, starterId])
  @@index([starterId, lastMessageAt])
  @@index([ownerId, lastMessageAt])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, id])
}